<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<BodyDef>
		<defName>RT_MegaroidBody</defName>
		<label>megaroid</label>
		<corePart>
			<def>RT_MegaroidMainBody</def>
			<height>Middle</height>
			<depth>Outside</depth>
			<parts>
        <!--Head is conceptual, but teeth are not-->
        <li>
          <def>RT_Head</def>
          <customLabel>head</customLabel>
          <coverage>0</coverage>
          <groups>
            <li>UpperHead</li>
            <li>FullHead</li>
            <li>HeadAttackTool</li>
          </groups>
        </li>

		<li>
			<def>RT_MegaroidMembrane</def>
			<customLabel>crystalline membrane</customLabel>
			<coverage>0.80</coverage>
		    <groups>
				<li>HeadAttackTool</li>
			</groups>
			<parts>
				<li>
					<def>RT_Mitosis</def>
					<customLabel>Mitosis</customLabel>
					<coverage>0.0000001</coverage>
					<depth>Inside</depth>
				</li>
				<li>
				    <def>RT_MegaroidNucleus</def>
					<customLabel>front nucleus</customLabel>
					<coverage>0.01</coverage>
					<depth>Inside</depth>
                    <groups>
						<li>Torso</li>
                    </groups>
                </li>
				<li>
					<def>RT_MegaroidNucleus</def>
					<customLabel>back nucleus</customLabel>
					<coverage>0.01</coverage>
					<depth>Inside</depth>
                    <groups>
						<li>Torso</li>
                    </groups>
				</li>
				<li>
					<def>RT_MegaroidNucleus</def>
					<customLabel>left nucleus</customLabel>
					<coverage>0.01</coverage>
					<depth>Inside</depth>
                    <groups>
					    <li>Torso</li>
                    </groups>
				</li>
				<li>
					<def>RT_MegaroidNucleus</def>
					<customLabel>right nucleus</customLabel>
					<coverage>0.01</coverage>
					<depth>Inside</depth>
                    <groups>
						<li>Torso</li>
                    </groups>
				</li>
				<li>
					<def>RT_MegaroidProtoplasm</def>
					<customLabel>Protoplasm</customLabel>
					<coverage>0.05</coverage>
					<depth>Inside</depth>
				</li>
				<li>
					<def>Heart</def>
					<customLabel>nucleus core</customLabel>
					<coverage>0.001</coverage>
					<depth>Inside</depth>
				</li>
			</parts>
				</li>
					<li>
						<def>AnimalJaw</def>
						<customLabel>front left tooth</customLabel>
						<coverage>0.04</coverage>
						<groups>
							<li>Teeth</li>
						</groups>
					</li>
					<li>
						<def>AnimalJaw</def>
						<customLabel>front right tooth</customLabel>
						<coverage>0.04</coverage>
						<groups>
							<li>Teeth</li>
						</groups>
					</li>
					<li>
						<def>AnimalJaw</def>
						<customLabel>back left tooth</customLabel>
						<coverage>0.04</coverage>
						<groups>
							<li>Teeth</li>
						</groups>
					</li>
					<li>
						<def>AnimalJaw</def>
						<customLabel>back right tooth</customLabel>
						<coverage>0.04</coverage>
						<groups>
							<li>Teeth</li>
						</groups>
					</li>
			</parts>
		</corePart>
	</BodyDef>

</Defs>

